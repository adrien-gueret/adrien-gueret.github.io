  <section class="container error-page"><p class="eyebrow">404</p><h1>Not quite the right place.</h1><p>This page does not exist, or may have moved.</p><a class="button" href="/">Back to the portfolio →</a><p lang="fr"><a href="/fr/">Retour au portfolio en français →</a></p></section>
</BaseLayout>
