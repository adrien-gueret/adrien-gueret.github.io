---
import '../styles/stories.css';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { homePath } from '../i18n/routes';
import type { Copy, Locale } from '../i18n/types';
interface Props { locale: Locale; copy: Copy; slug: string; title: string; description: string; name: string; context: string }
const { locale, copy, slug, title, description, name, context } = Astro.props;
---
<BaseLayout locale={locale} copy={copy} slug={slug} title={`${title} | Adrien Guéret`} description={description}>
  <article class="case-study editorial-case container">
    <Breadcrumbs locale={locale} homeLabel={copy.labels.home} title={name} />
    <header class="case-header">
      <p class="eyebrow">{context} / Case study</p>
      <h1>{title}</h1>
      <div class="case-introduction"><slot name="introduction" /></div>
    </header>
    <slot />
    <footer class="case-footer"><a class="text-link" href={`${homePath(locale)}#work`}><span aria-hidden="true">← </span>{copy.labels.back}</a><slot name="footer" /></footer>
  </article>
</BaseLayout>
