---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import JsonLd from '../components/JsonLd.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeScript from '../components/ThemeScript.astro';
import { structuredData } from '../lib/structured-data';
import type { Copy, Locale } from '../i18n/types';
interface Props { locale: Locale; copy: Copy; title: string; description: string; slug?: string; noindex?: boolean }
const { locale, copy, title, description, slug, noindex = false } = Astro.props;
---
<!doctype html>
<html lang={locale}>
  <head>
    <SeoHead locale={locale} title={title} description={description} slug={slug} noindex={noindex} />
    <ThemeScript />
    {!noindex && <JsonLd graph={structuredData(locale, title, description, slug)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.nav.skip}</a>
    <Header locale={locale} copy={copy} slug={slug} />
    <main id="main"><slot /></main>
    <Footer locale={locale} />
    <script>import '../scripts/language';</script>
  </body>
</html>
