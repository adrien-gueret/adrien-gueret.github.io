---
import { profile } from '../data/profile';
import type { Locale } from '../i18n/types';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<footer class="site-footer container">
  <p>© {new Date().getUTCFullYear()} {profile.name}</p>
  <nav class="footer-socials" aria-label={locale === 'fr' ? 'Profils sociaux' : 'Social profiles'}>
    <a class="footer-social-link" href={profile.github}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.74-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18a10.97 10.97 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.4-5.28 5.69.42.36.78 1.06.78 2.14v3.26c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
      <span>GitHub <span aria-hidden="true">↗</span></span>
    </a>
    <a class="footer-social-link" href={profile.linkedin}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M5.34 3.5A2.34 2.34 0 1 1 .66 3.5a2.34 2.34 0 0 1 4.68 0ZM1.06 7.16h3.86V19.5H1.06V7.16Zm6.34 0h3.7v1.69h.05c.52-.97 1.78-1.99 3.66-1.99 3.91 0 4.63 2.57 4.63 5.92v6.72h-3.85v-5.96c0-1.42-.03-3.25-1.99-3.25-1.99 0-2.29 1.55-2.29 3.15v6.06H7.4V7.16Z" transform="translate(2 1)"/></svg>
      <span>LinkedIn <span aria-hidden="true">↗</span></span>
    </a>
  </nav>
</footer>
