---
import '../../styles/stories.css';
import ProjectFigure from '../ProjectFigure.astro';
import { guessr, openclassrooms, storyImages, unbalanced, universalis } from '../../data/projects';
import { number, workPath } from '../../i18n/routes';
import type { Copy, Locale } from '../../i18n/types';
interface Props { copy: Copy; locale: Locale }
const { copy, locale } = Astro.props;
const projects = copy.work.projects;
const fr = locale === 'fr';
const [universalisIntro, universalisOutro] = projects.universalis.description.split(universalis.name);
const [guessrIntro, guessrOutro] = projects.guessr.description.split('Mario Kart World');
---
<section class="section container work-stories" id="work" aria-labelledby="work-title">
  <div class="section-heading"><div><h2 id="work-title">{copy.work.title}</h2><p>{copy.work.intro}</p></div></div>
  <article class="work-story story-engineering" aria-labelledby="story-engineering-title">
    <div class="story-copy">
      <p class="eyebrow">2016 <span aria-hidden="true">→</span> {fr ? "Aujourd'hui" : 'Today'}</p>
      <h3 id="story-engineering-title">{projects.engineering.title}</h3>
      <p>{projects.engineering.description}</p>
      <a class="button story-link" href={workPath(locale, openclassrooms.slug)} aria-label={copy.work.study + ' : ' + openclassrooms.name}>{copy.work.study} <span aria-hidden="true">→</span></a>
    </div>
    <ProjectFigure image={storyImages.engineering[locale]} alt={fr ? "La page d'accueil publique d'OpenClassrooms en français." : 'The public OpenClassrooms homepage in English.'} caption={fr ? "La page d'accueil d'OpenClassrooms." : "The OpenClassrooms homepage."} pending={fr ? 'OpenClassrooms · image à venir' : 'OpenClassrooms · image to come'} />
  </article>
  <article class="work-story story-universalis" aria-labelledby="story-universalis-title">
    <div class="story-copy">
      <p class="eyebrow">{fr ? 'Depuis' : 'Since'} {universalis.created}</p>
      <h3 id="story-universalis-title">{universalis.name}</h3>
      <p>{universalisIntro}<strong>{universalis.name}</strong>{universalisOutro}</p>
      <ul class="story-numbers">
        <li><strong>{number(Math.floor(universalis.games / 50) * 50, locale)}+</strong> {fr ? 'jeux Mario enregistrés' : 'Mario games documented'}</li>
        <li><strong>{number(universalis.relatedProjects, locale)}+</strong> {fr ? <>outils, services et sites autour de <em>Super Mario</em></> : <>tools, services and websites about <em>Super Mario</em></>}</li>
        <li><strong>{number(universalis.twitterFollowers, locale)}+</strong> {fr ? 'followers sur le compte Twitter' : 'followers on the Twitter account'}</li>
        <li><strong>{number(universalis.publishedAnecdotes, locale)}+</strong> {fr ? 'anecdotes Mario publiées' : 'Mario facts published'}</li>
      </ul>
      <a class="button story-link" href={workPath(locale, universalis.slug)} aria-label={copy.work.study + ' : ' + universalis.name}>{copy.work.study} <span aria-hidden="true">→</span></a>
    </div>
    <ProjectFigure image={storyImages.universalis} alt={fr ? 'Le visuel Mario Universalis sur un fond étoilé.' : 'The Mario Universalis artwork on a starry background.'} caption={fr ? 'Le point de départ de presque vingt ans d’expérimentations.' : 'The starting point for almost twenty years of experiments.'} pending={fr ? 'Mario Universalis · capture à venir' : 'Mario Universalis · screenshot to come'} />
  </article>
  <article class="work-story story-guessr" aria-labelledby="story-guessr-title">
    <div class="story-copy">
      <p class="eyebrow">{fr ? 'Un projet Mario Universalis · Depuis' : 'A Mario Universalis project · Since'} {guessr.launched.slice(0, 4)}</p>
      <h3 id="story-guessr-title">{guessr.name}</h3>
      <p>{guessrIntro}<em>Mario Kart World</em>{guessrOutro}</p>
      <ul class="story-numbers">
        <li><strong>{number(Math.floor(guessr.metrics.games / 1000) * 1000, locale)}+</strong> {copy.labels.games}</li>
        <li><strong>{number(guessr.metrics.publishedPhotos, locale)}+</strong> {copy.labels.photos}</li>
        <li><strong>{number(guessr.metrics.publishedContributors, locale)}+</strong> {copy.labels.contributors}</li>
      </ul>
      <a class="button story-link" href={workPath(locale, guessr.slug)} aria-label={copy.work.study + ' : ' + guessr.name}>{copy.work.study} <span aria-hidden="true">→</span></a>
    </div>
    <ProjectFigure image={storyImages.guessr[locale]} alt={fr ? 'Le logo Mario Kart World Guessr.' : 'The Mario Kart World Guessr logo.'} pending={fr ? 'Mario Kart World Guessr · visuel à venir' : 'Mario Kart World Guessr · image to come'}>
      <Fragment slot="caption">{fr ? <><em>Mario Kart World Guessr</em> comporte plus de 1700 photos grâce à sa communauté.</> : <> <em>Mario Kart World Guessr</em> has over 1700 photos thanks to its community.</>}</Fragment>
    </ProjectFigure>
  </article>
  <article class="work-story story-unbalanced" aria-labelledby="story-unbalanced-title">
    <div class="story-copy">
      <p class="eyebrow">{unbalanced.context} · {unbalanced.year}</p>
      <h3 id="story-unbalanced-title">{unbalanced.name}</h3>
      <p>{projects.unbalanced.description}</p>
      <ul class="story-numbers">{unbalanced.ranks.map((rank) => <li><strong>{fr ? '1er prix' : '1st prize'}</strong> {fr ? <>dans la catégorie « {rank.category} »</> : <>in the “{rank.category}” category</>}</li>)}</ul>
      <a class="button story-link" href={workPath(locale, unbalanced.slug)} aria-label={copy.work.study + ' : ' + unbalanced.name}>{copy.work.study} <span aria-hidden="true">→</span></a>
    </div>
    <ProjectFigure image={storyImages.unbalanced[locale]} alt={fr ? "L'écran d'accueil en français de This Game Is Unbalanced!." : 'The English home screen of This Game Is Unbalanced!.'} caption={fr ? 'Une game jam pour apprendre et expérimenter avec l\'intelligence artificielle.' : 'A game jam to learn and experiment with artificial intelligence.'} pending={fr ? 'This Game Is Unbalanced! · capture à venir' : 'This Game Is Unbalanced! · screenshot to come'} />
  </article>
</section>
